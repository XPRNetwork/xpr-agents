{
  "id": "openclaw",
  "name": "XPR Agents",
  "configSchema": {
    "type": "object",
    "properties": {
      "network": {
        "type": "string",
        "enum": ["mainnet", "testnet"],
        "default": "mainnet"
      },
      "rpcEndpoint": {
        "type": "string",
        "description": "XPR Network RPC endpoint URL"
      },
      "indexerUrl": {
        "type": "string",
        "default": "http://localhost:3001"
      },
      "contracts": {
        "type": "object",
        "properties": {
          "agentcore": { "type": "string", "default": "agentcore" },
          "agentfeed": { "type": "string", "default": "agentfeed" },
          "agentvalid": { "type": "string", "default": "agentvalid" },
          "agentescrow": { "type": "string", "default": "agentescrow" }
        }
      },
      "confirmHighRisk": {
        "type": "boolean",
        "default": true
      },
      "maxTransferAmount": {
        "type": "number",
        "default": 10000000
      }
    }
  },
  "uiHints": {
    "network": { "label": "Network" },
    "rpcEndpoint": { "label": "RPC Endpoint" },
    "indexerUrl": { "label": "Indexer URL" },
    "confirmHighRisk": { "label": "Confirm High-Risk Actions" }
  },
  "skills": [
    "skills/xpr-agent-operator",
    "skills/creative",
    "skills/web-scraping",
    "skills/code-sandbox",
    "skills/structured-data",
    "skills/defi",
    "skills/nft",
    "skills/tax",
    "skills/lending",
    "skills/governance",
    "skills/xmd",
    "skills/smart-contracts",
    "skills/shellbook"
  ]
}
