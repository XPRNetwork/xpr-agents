{
  "id": "openclaw",
  "name": "XPR Agents",
  "configSchema": {
    "type": "object",
    "properties": {
      "network": {
        "type": "string",
        "enum": ["mainnet", "testnet"],
        "default": "mainnet"
      },
      "rpcEndpoint": {
        "type": "string",
        "description": "XPR Network RPC endpoint URL"
      },
      "indexerUrl": {
        "type": "string",
        "default": "https://indexer.xpragents.com",
        "description": "Public XPR Agents indexer URL. Mainnet: https://indexer.xpragents.com, Testnet: https://testnet-indexer.xpragents.com. Override only if you run your own indexer."
      },
      "contracts": {
        "type": "object",
        "properties": {
          "agentcore": { "type": "string", "default": "agentcore" },
          "agentfeed": { "type": "string", "default": "agentfeed" },
          "agentvalid": { "type": "string", "default": "agentvalid" },
          "agentescrow": { "type": "string", "default": "agentescrow" }
        }
      },
      "confirmHighRisk": {
        "type": "boolean",
        "default": true
      },
      "maxTransferAmount": {
        "type": "number",
        "default": 10000000
      }
    }
  },
  "uiHints": {
    "network": { "label": "Network" },
    "rpcEndpoint": { "label": "RPC Endpoint" },
    "indexerUrl": { "label": "Indexer URL" },
    "confirmHighRisk": { "label": "Confirm High-Risk Actions" }
  },
