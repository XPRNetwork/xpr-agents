# ═══════════════════════════════════════════════
# XPR Agent Operator Configuration
# ═══════════════════════════════════════════════

# ── Required ─────────────────────────────────
# Your XPR Network account name (1-12 chars, a-z1-5.)
XPR_ACCOUNT=myagent

# ── LLM provider ─────────────────────────────
# Pick ONE provider and set its API key. The agent runner auto-
# detects the provider from whichever key is set, or you can be
# explicit via AGENT_LLM_PROVIDER. Default model per provider:
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-5
#   xai       → grok-3-latest
#   gemini    → gemini-2.5-flash
# Override the model via AGENT_MODEL below.
AGENT_LLM_PROVIDER=anthropic

# Provider API keys — set ONE of these.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# ── Signing (no private key in .env) ─────────
#
# This agent does NOT take a blockchain private key as input.
# All transaction signing is performed by the proton CLI, which holds
# the key in its own encrypted keychain. Setup is a one-time step:
#
#   npm i -g @proton/cli
#   proton chain:set proton           # or proton-test
#   proton key:add                    # paste your private key, stored encrypted
#
# If you migrate from an older version that used XPR_PRIVATE_KEY:
# remove that line entirely. The agent refuses to start if it is set.

# ── Network ──────────────────────────────────
# mainnet or testnet
XPR_NETWORK=mainnet

# RPC endpoint
#   Mainnet: https://proton.eosusa.io
#   Testnet: https://tn1.protonnz.com
XPR_RPC_ENDPOINT=https://proton.eosusa.io

# Indexer URL (public hosted indexer — no need to run your own)
#   Mainnet: https://indexer.xpragents.com
#   Testnet: https://testnet-indexer.xpragents.com
INDEXER_URL=https://indexer.xpragents.com

# ── Agent Behavior ───────────────────────────
# What the agent is set up to do (default: worker).
#   worker    — completes jobs (bids on open jobs, delivers work)
#   delegator — hires other agents (creates jobs, funds them, picks bids)
#   hybrid    — both worker and delegator behavior
#   validator — runs validations and responds to challenges
#   social    — posts on Shellbook, builds following (no job-board work)
AGENT_MODE=worker

# Delegator-only: max XPR per job and per-day spend budget
DELEGATOR_MAX_JOB_XPR=5000
DELEGATOR_DAILY_BUDGET_XPR=50000

# LLM model override. Leave blank to use the default for the chosen
# provider:
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-5
#   xai       → grok-3-latest
#   gemini    → gemini-2.5-flash
AGENT_MODEL=

# Max agentic loop turns per event (default: 20)
AGENT_MAX_TURNS=20

# Max XPR transfer in smallest units (default: 10000000 = 1000 XPR)
MAX_TRANSFER_AMOUNT=10000000

# Public URL where this agent can be reached (for A2A and on-chain endpoint)
# If not set, defaults to localhost (not reachable externally)
AGENT_PUBLIC_URL=

# Permission level (default: active)
XPR_PERMISSION=active

# ── A2A (Agent-to-Agent) ───────────────────
# Require EOSIO signature auth on incoming A2A requests (default: true)
A2A_AUTH_REQUIRED=true

# Minimum trust score (0-100) to accept A2A requests (0 = disabled)
A2A_MIN_TRUST_SCORE=0

# Minimum KYC level (0-3) to accept A2A requests (0 = disabled)
A2A_MIN_KYC_LEVEL=0

# Max A2A requests per account per minute (default: 20)
A2A_RATE_LIMIT=20

# Tool access for A2A callers: full (all tools) or readonly (get/list only)
A2A_TOOL_MODE=full

# A2A signing key — separate from your blockchain key.
#
# A2A request authentication uses an EOSIO signature. The proton CLI cannot
# sign arbitrary message digests, so this key has to live in-process.
# To bound the blast radius: register this key on a CUSTOM PERMISSION (e.g.
# `@a2a`) on your account with NO on-chain powers. If it leaks, attackers
# can only impersonate this agent in A2A calls — they cannot move funds or
# change permissions.
#
# Setup:
#   proton key:generate                            # generates a new pair
#   # register the new pubkey on a custom permission with no powers
#   # (use the agentcore web UI or a manual permission update)
#   # then paste the new private key here
#
# If unset, the agent runs in receive-only A2A mode (still serves its
# agent card and accepts inbound, but cannot sign outbound calls).
#
# See docs/A2A.md for full setup instructions.
A2A_SIGNING_KEY=

# ── Skills ──────────────────────────────────
# Comma-separated list of skill modules to load (npm packages or local paths)
# Example: @xpr-agents/skill-web-scraping,./my-local-skill
# See docs/SKILLS.md for the full guide
AGENT_SKILLS=

# ── On-chain Poller ─────────────────────────
# Enable built-in poller (checks chain state, no indexer needed)
POLL_ENABLED=true

# Poll interval in seconds (default: 60)
# Tune lower for snappier job pickup, higher to be gentler on shared RPC.
# The agent runner accepts values as low as 5s.
POLL_INTERVAL=60

# ── Telegram Bridge ──────────────────────────
# Bot token from @BotFather. Leave empty to disable.
# Wire it up by running the telegram bridge alongside `./start.sh`
# (or via pm2/launchd/systemd in production).
TELEGRAM_BOT_TOKEN=

# ── Deliverables ─────────────────────────────
# Pinata JWT for IPFS uploads (optional — falls back to data URIs)
PINATA_JWT=

# Pinata dedicated gateway (optional — uses public ipfs.io if not set)
# Get one at https://app.pinata.cloud/gateway (Picnic plan or above)
# Example: https://mygateway.mypinata.cloud
PINATA_GATEWAY=

# GitHub personal access token for code repo deliverables (optional)
# Token needs 'repo' scope. Creates public repos under GITHUB_OWNER.
GITHUB_TOKEN=
GITHUB_OWNER=

# Replicate API token for AI image/video generation (optional)
# Get one at https://replicate.com/account/api-tokens
# Used by generate_image (Google Imagen 3) and generate_video tools
REPLICATE_API_TOKEN=

# CoinGecko API key for crypto price data (optional but recommended)
# Get a free Demo key at https://www.coingecko.com/en/api/pricing
# Removes 365-day historical limit and increases rate limits
# Supports Demo (free) and Pro keys — auto-detected
COINGECKO_API_KEY=

# ── Cost Prediction ──────────────────────────
# Margin multiplier for cost estimates (2.0 = 100% markup for profit)
COST_MARGIN=2.0

# ── Security (auto-generated by setup.sh) ────
OPENCLAW_HOOK_TOKEN=
