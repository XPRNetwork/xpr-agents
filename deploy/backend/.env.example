# XPR Network configuration
XPR_NETWORK=testnet
XPR_RPC_ENDPOINT=https://testnet.xprnetwork.org

# Deploy service account (has permission to create accounts)
DEPLOY_ACCOUNT=agentdeploy
DEPLOY_PRIVATE_KEY=PVT_K1_...

# Contract accounts
CORE_CONTRACT=agentcore
DEPLOY_CONTRACT=agentdeploy

# Key encryption (for storing agent private keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=

# Cloudflare deployment
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Server
PORT=3500
API_SECRET=  # Bearer token for admin endpoints

# Database
DB_PATH=./data/deploy.db
